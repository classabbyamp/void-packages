# Template file for 'opentmux'
pkgname=opentmux
version=0.1
revision=1
build_style=meson
configure_args="-Dutempter=enabled -Dsixel=true"
hostmakedepends="byacc pkg-config lowdown"
makedepends="libevent-devel libutempter-devel ncurses-devel"
depends="ncurses-base"
short_desc="Terminal Multiplexer, fork of tmux"
maintainer="classabbyamp <dev@placeviolette.net>"
license="ISC"
homepage="https://codeberg.org/opentmux/opentmux"
changelog="https://codeberg.org/opentmux/opentmux/raw/branch/main/CHANGELOG.md"
distfiles="https://codeberg.org/opentmux/opentmux/archive/v${version}.tar.gz"
checksum=b160f4db35b4262ba6653ae6f3dc24ee33f94bdd0de616af80127165698fc57c
conflicts="tmux>=0"
replaces="tmux>=0"

post_install() {
	{
		echo ' * Copyright (c) 2007-2021 Nicholas Marriott <nicholas.marriott@gmail.com>'
		grep -rh  'Copyright (c) .*[0-9] [a-zA-Z]' *.c compat/*.c |
			grep -v 'Nicholas Marriott' | sort -u
		cat COPYING
	} >LICENSE
	vlicense LICENSE
}
